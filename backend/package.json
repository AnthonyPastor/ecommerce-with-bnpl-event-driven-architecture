{
  "name": "bnpl-backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./apps/** run build",
    "test": "pnpm -r --filter=./apps/** run test",
    "test:e2e": "pnpm --filter e2e run test",
    "lint": "pnpm -r --filter=./apps/** run lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
