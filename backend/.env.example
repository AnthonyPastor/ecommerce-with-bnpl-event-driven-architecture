# Reference for the environment variables used across the microservices.
# Each service under apps/<service> has its own .env.example with the subset that applies to it.

# --- Postgres (one database per service, same host/port) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnpl
POSTGRES_PASSWORD=bnpl
# POSTGRES_DB differs per service: auth_db | catalog_db | cart_db | order_db | payment_db | bnpl_db | notification_db

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- RabbitMQ ---
RABBITMQ_URL=amqp://bnpl:bnpl@localhost:5672

# --- Redis (optional: rate limiting in api-gateway, refresh-token blacklist in auth-service) ---
REDIS_URL=redis://localhost:6379

# --- Auth (auth-service) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Payment gateway (payment-service) ---
PAYMENT_GATEWAY_PROVIDER=fake

# --- Email provider (notification-service) ---
EMAIL_PROVIDER=console
