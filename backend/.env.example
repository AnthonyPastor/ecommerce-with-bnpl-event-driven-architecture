# Referencia de las variables de entorno usadas across los microservicios.
# Cada servicio bajo apps/<service> tiene su propio .env.example con el subconjunto que le aplica.

# --- Postgres (una base por servicio, mismo host/puerto) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnpl
POSTGRES_PASSWORD=bnpl
# POSTGRES_DB difiere por servicio: auth_db | catalog_db | cart_db | order_db | payment_db | bnpl_db | notification_db

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- RabbitMQ ---
RABBITMQ_URL=amqp://bnpl:bnpl@localhost:5672

# --- Redis (opcional: rate limiting en api-gateway, blacklist de refresh tokens en auth-service) ---
REDIS_URL=redis://localhost:6379

# --- Auth (auth-service) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Payment gateway (payment-service) ---
PAYMENT_GATEWAY_PROVIDER=fake

# --- Email provider (notification-service) ---
EMAIL_PROVIDER=console
