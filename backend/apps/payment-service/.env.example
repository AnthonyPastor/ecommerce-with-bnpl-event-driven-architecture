PORT=3005
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnpl
POSTGRES_PASSWORD=bnpl
POSTGRES_DB=payment_db
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://bnpl:bnpl@localhost:5672

# active payment gateway provider (repository pattern): 'fake' | 'mercadopago' | 'paypal'
PAYMENT_GATEWAY_PROVIDER=fake
# Bounds PaymentsService.createPayment()'s call to gateway.authorize() so a hanging
# real gateway adapter can't leave a Transaction stuck at PENDING forever.
PAYMENT_GATEWAY_TIMEOUT_MS=10000

# Public base URL of this same service, used by FakePaymentGateway to
# simulate the async webhook confirming capture (self-loopback).
PAYMENT_SERVICE_SELF_URL=http://localhost:3005
FAKE_GATEWAY_WEBHOOK_SECRET=fake-gateway-shared-secret
# Simulated delay before the fake gateway confirms the capture via webhook (ms).
FAKE_GATEWAY_CAPTURE_DELAY_MS=2000
