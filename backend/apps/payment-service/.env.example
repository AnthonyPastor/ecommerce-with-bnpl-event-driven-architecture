PORT=3005
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnpl
POSTGRES_PASSWORD=bnpl
POSTGRES_DB=payment_db
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://bnpl:bnpl@localhost:5672

# proveedor de payment gateway activo (repository pattern): 'fake' | 'mercadopago' | 'paypal'
PAYMENT_GATEWAY_PROVIDER=fake

# Base URL pública de este mismo servicio, usada por FakePaymentGateway para
# simular el webhook asíncrono de confirmación de captura (self-loopback).
PAYMENT_SERVICE_SELF_URL=http://localhost:3005
FAKE_GATEWAY_WEBHOOK_SECRET=fake-gateway-shared-secret
# Delay simulado antes de que el fake gateway confirme la captura por webhook (ms).
FAKE_GATEWAY_CAPTURE_DELAY_MS=2000
